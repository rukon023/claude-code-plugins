{
  "description": "Shows a Windows notification when Claude finishes and waits for you, and when Claude is blocked on a permission prompt",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -STA -File \"${CLAUDE_PLUGIN_ROOT}/hooks/toast-notify.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -STA -File \"${CLAUDE_PLUGIN_ROOT}/hooks/toast-notify.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
