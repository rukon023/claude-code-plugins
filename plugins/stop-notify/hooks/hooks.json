{
  "description": "Shows a Windows notification with Claude's final message when the main session finishes and waits for you",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -STA -File \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-notify.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
